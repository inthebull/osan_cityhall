{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI 주무관 정의",
  "description": "AI 주무관 한 명의 담당 범위(자리, 지침)와 소통 방식. 실명·연락처는 넣지 않고 가상 민원인은 '가상민원인A'처럼 적는다.",
  "type": "object",
  "required": ["officer_id", "dept_id", "team", "name", "title", "intro", "seat_ids", "doc_ids", "modes", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "officer_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "dept_id": { "enum": ["D-CIVIL", "D-ELDER", "D-DONG"] },
    "team": { "type": "string" },
    "name": { "type": "string" },
    "title": { "type": "string" },
    "room_id": { "type": "string" },
    "intro": { "type": "string" },
    "seat_ids": { "type": "array", "items": { "type": "string", "pattern": "^S-[A-Z]+-[0-9]{2}$" }, "minItems": 1 },
    "doc_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "modes": {
      "type": "object",
      "required": ["ask", "notice", "roleplay"],
      "additionalProperties": false,
      "patternProperties": {
        "": {
          "type": "object",
          "required": ["label", "hint", "samples"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string" },
            "hint": { "type": "string" },
            "samples": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario_id", "title", "persona", "opening", "facts"],
        "additionalProperties": false,
        "properties": {
          "scenario_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string" },
          "persona": { "type": "string", "pattern": "가상민원인" },
          "opening": { "type": "string" },
          "facts": { "type": "string" }
        }
      }
    }
  }
}
